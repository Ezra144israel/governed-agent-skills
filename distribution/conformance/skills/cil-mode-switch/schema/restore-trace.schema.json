{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIL Restore Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "state", "action", "sourceChecks", "authorityReceipts", "triggerAttachment", "baseline", "minimumReadSet", "cilRef", "capabilityEvidence"],
  "properties": {
    "event": { "enum": ["REENTRY", "COMPACTION", "MANUAL_RESTORE", "COMPONENT_DRIFT"] },
    "state": { "enum": ["CURRENT", "UPDATED", "RECONSTRUCTED", "DEGRADED", "ESCALATED"] },
    "action": { "enum": ["CONTINUE", "REFRESH_CHANGED_SOURCES", "FULL_SWITCH"] },
    "sourceChecks": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["status", "identity"], "properties": { "status": { "enum": ["VERIFIED", "CHANGED", "UNVERIFIABLE", "UNKNOWN"] }, "identity": { "type": "string" } } } },
    "authorityReceipts": { "type": "object", "additionalProperties": false, "required": ["seat", "governance"], "properties": { "seat": { "type": "string" }, "governance": { "type": "string" } } },
    "triggerAttachment": { "enum": ["VERIFIED", "NOT_APPLICABLE", "UNVERIFIABLE"] },
    "baseline": { "enum": ["PRESENT", "MISSING"] },
    "minimumReadSet": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "cilRef": { "type": "object", "additionalProperties": false, "required": ["value", "source"], "properties": { "value": { "type": ["string", "null"] }, "source": { "enum": ["LIVE", "BASELINE", "UNAVAILABLE"] } } },
    "capabilityEvidence": { "type": "object", "additionalProperties": false, "required": ["state", "recordIdentity", "pinIdentity", "authorityBoundary"], "properties": { "state": { "enum": ["PIN_VERIFIED", "UNVERIFIABLE"], "description": "Record integrity against the install pin. Not independence." }, "recordIdentity": { "type": ["string", "null"] }, "pinIdentity": { "type": ["string", "null"] }, "authorityBoundary": { "enum": ["INSTALL_BOUND", "UNPROVEN"], "description": "Whether an install authority receipt claims the evidence home is outside the evaluating actor's reach. UNPROVEN means integrity only, and the R1-b NOT_APPLICABLE exemption is refused." } } }
  }
}
