{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIL Mode Baseline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cilRef": { "type": "string" },
    "cilTree": { "type": "string" },
    "postureSources": { "type": "array", "items": { "type": "object", "required": ["path", "identity"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "identity": { "type": "string" } } } },
    "standingStack": { "type": "array", "items": { "type": "object", "required": ["id", "identity"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "identity": { "type": "string" } } } },
    "authorityPointers": { "type": "array", "items": { "type": "object", "required": ["kind", "locator"], "additionalProperties": false, "properties": { "kind": { "enum": ["seat", "governance"] }, "locator": { "type": "string" } } } },
    "recallIndex": { "type": "object", "additionalProperties": false, "properties": { "identity": { "type": "string" }, "state": { "enum": ["CURRENT", "BEHIND", "UNKNOWN"] } } },
    "continuityId": { "type": "string" },
    "lastRestoreTrace": { "type": "string" }
  }
}
