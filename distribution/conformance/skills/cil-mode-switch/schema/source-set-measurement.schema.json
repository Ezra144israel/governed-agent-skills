{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIL Full Switch Source-Set Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["branchNotes"],
  "properties": {
    "branchNotes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "identity", "effect"],
        "properties": {
          "id": { "enum": ["chatgpt", "claude", "codex", "gemini", "claude-code"] },
          "identity": { "type": "string" },
          "effect": { "enum": ["CHANGED_ACTION", "RULED_OUT"] }
        }
      }
    }
  }
}
