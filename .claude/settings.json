{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-tooth.sh\" baseline",
            "timeout": 10,
            "statusMessage": "Memory tooth: baselining session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-tooth.sh\" check",
            "timeout": 10,
            "statusMessage": "Memory tooth: checking write duty"
          }
        ]
      }
    ]
  }
}
